STT_TOKEN_URL=https://keycloak.stt-pp.e-tax.impots.gov.mr/auth/realms/stt/protocol/openid-connect/token
STT_API_BASE_URL=https://api.stt-pp.e-tax.impots.gov.mr
STT_CLIENT_ID=
STT_CLIENT_SECRET=

# CORS : true = toutes origines autorisées (par défaut, pratique en interne).
# Passez à false et listez CORS_ALLOWED_ORIGINS pour restreindre en production.
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=

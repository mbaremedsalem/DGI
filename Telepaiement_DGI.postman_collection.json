            "script": { "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('payment_transaction_id_reject', json.transactionId);",
              "pm.test('Status 201', () => pm.response.to.have.status(201));"
            ]}
          }]
        },
        {
          "name": "3.9 POST /update - Initiation IN_PROGRESS (pour rejet)",
          "request": {

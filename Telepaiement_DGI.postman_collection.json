            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"{{payment_transaction_id_reject}}\",\n  \"notificationType\": \"PAYMENT\",\n  \"status\": \"IN_PROGRESS\"\n}"
            },
            "url": { "raw": "{{base_url}}/update", "host": ["{{base_url}}"], "path": ["update"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]}
          }]
        },
        {
          "name": "3.10 POST /update - Validation REJECTED avec code 005",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"{{payment_transaction_id_reject}}\",\n  \"notificationType\": \"PAYMENT\",\n  \"status\": \"REJECTED\",\n  \"rejectionReasonCode\": \"005\"\n}"
            },
            "url": { "raw": "{{base_url}}/update", "host": ["{{base_url}}"], "path": ["update"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]}
          }]
        },
        {
          "name": "3.11 GET détails paiement - transactionId inexistant (404)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/notification/PAYMENT/00000000-0000-0000-0000-000000000000",
              "host": ["{{base_url}}"], "path": ["notification", "PAYMENT", "00000000-0000-0000-0000-000000000000"]
            }
          },
          "event": [{
            "listen": "test",

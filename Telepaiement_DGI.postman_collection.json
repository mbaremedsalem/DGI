            "url": { "raw": "{{base_url}}/update", "host": ["{{base_url}}"], "path": ["update"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 400 (validation serializer)', () => pm.response.to.have.status(400));"
            ]}
          }]
        }
      ]
    }
  ]
